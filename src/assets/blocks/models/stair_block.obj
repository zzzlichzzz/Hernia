# Stair block with correct proportional UV
mtllib stair_block.mtl

o StairBlock

# Left vertices (x=0)
v 0.000000 1.000000 0.000000
v 0.000000 1.000000 0.500000
v 0.000000 0.500000 0.000000
v 0.000000 0.500000 0.500000
v 0.000000 0.500000 1.000000
v 0.000000 0.000000 0.000000
v 0.000000 0.000000 1.000000

# Right vertices (x=1)
v 1.000000 1.000000 0.000000
v 1.000000 1.000000 0.500000
v 1.000000 0.500000 0.000000
v 1.000000 0.500000 0.500000
v 1.000000 0.500000 1.000000
v 1.000000 0.000000 0.000000
v 1.000000 0.000000 1.000000

# ═══ UV COORDINATES ═══

# 1: Full face 1x1 (rotated 90° CW)
vt 0.000000 0.000000
vt 0.000000 1.000000
vt 1.000000 1.000000
vt 1.000000 0.000000

# 5-8: Front steps - half height (1 wide x 0.5 tall, correct orientation)
vt 0.000000 0.000000
vt 0.000000 0.500000
vt 1.000000 0.500000
vt 1.000000 0.000000

# 9-12: Top surfaces - half depth (1 wide x 0.5 deep, correct orientation)
vt 0.000000 0.000000
vt 0.000000 0.500000
vt 1.000000 0.500000
vt 1.000000 0.000000

# 13-16: Side lower - full width x half height (correct orientation)
vt 0.000000 0.000000
vt 0.000000 0.500000
vt 1.000000 0.500000
vt 1.000000 0.000000

# 17-20: Side upper - half width x half height (correct orientation)
vt 0.500000 0.000000
vt 0.500000 0.500000
vt 1.000000 0.500000
vt 1.000000 0.000000

# Normals
vn 0.0000 1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn -1.0000 0.0000 0.0000
vn 1.0000 0.0000 0.0000
vn 0.0000 0.0000 -1.0000
vn 0.0000 0.0000 1.0000

s off
usemtl default

# ═══ BOTTOM (y=0) - full 1x1 ═══
f 13/1/2 14/2/2 7/3/2 6/4/2

# ═══ BACK WALL (z=0, full height) - full 1x1 ═══
f 6/1/5 1/2/5 8/3/5 13/4/5

# ═══ FRONT LOWER STEP (z=1, y=0 to 0.5) - 1x0.5 ═══
f 14/5/6 12/6/6 5/7/6 7/8/6

# ═══ FRONT UPPER STEP (z=0.5, y=0.5 to 1) - 1x0.5 ═══
f 11/5/6 9/6/6 2/7/6 4/8/6

# ═══ TOP UPPER STEP (y=1, z=0 to 0.5) - 1x0.5 ═══
f 9/9/1 8/10/1 1/11/1 2/12/1

# ═══ TOP LOWER STEP (y=0.5, z=0.5 to 1) - 1x0.5 ═══
f 12/9/1 11/10/1 4/11/1 5/12/1

# ═══ LEFT LOWER (y=0 to 0.5, z=0 to 1) - 1x0.5 ═══
f 7/13/3 5/14/3 3/15/3 6/16/3

# ═══ LEFT UPPER (y=0.5 to 1, z=0 to 0.5) - 0.5x0.5 ═══
f 4/17/3 2/18/3 1/19/3 3/20/3

# ═══ RIGHT LOWER (y=0 to 0.5, z=0 to 1) - 1x0.5 ═══
f 13/13/4 10/14/4 12/15/4 14/16/4

# ═══ RIGHT UPPER (y=0.5 to 1, z=0 to 0.5) - 0.5x0.5 ═══
f 10/17/4 8/18/4 9/19/4 11/20/4