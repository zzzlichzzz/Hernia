# Standard cube with correct UV mapping and CCW winding
mtllib standard_cube.mtl

o StandardCube

v 0.000000 0.000000 0.000000
v 1.000000 0.000000 0.000000
v 1.000000 1.000000 0.000000
v 0.000000 1.000000 0.000000
v 0.000000 0.000000 1.000000
v 1.000000 0.000000 1.000000
v 1.000000 1.000000 1.000000
v 0.000000 1.000000 1.000000

vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

vn 0.0000 1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 0.0000 1.0000
vn 0.0000 0.0000 -1.0000
vn 1.0000 0.0000 0.0000
vn -1.0000 0.0000 0.0000

s off
usemtl default

# Top (Y+) - CCW when viewed from above
f 4/1/1 8/2/1 7/3/1 3/4/1

# Bottom (Y-) - CCW when viewed from below
f 1/1/2 2/2/2 6/3/2 5/4/2

# Front (Z+) - CCW when viewed from front
f 5/1/3 6/2/3 7/3/3 8/4/3

# Back (Z-) - CCW when viewed from back
f 2/1/4 1/2/4 4/3/4 3/4/4

# Right (X+) - CCW when viewed from right
f 6/1/5 2/2/5 3/3/5 7/4/5

# Left (X-) - CCW when viewed from left
f 1/1/6 5/2/6 8/3/6 4/4/6