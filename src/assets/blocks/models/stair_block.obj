# Stair block
# Bottom step: y=0 to 0.5, full depth
# Top step: y=0.5 to 1.0, z=0 to 0.5
mtllib stair_block.mtl

o StairBlock

# Left vertices (x=0)
v 0.000000 1.000000 0.000000
v 0.000000 1.000000 0.500000
v 0.000000 0.500000 0.000000
v 0.000000 0.500000 0.500000
v 0.000000 0.500000 1.000000
v 0.000000 0.000000 0.000000
v 0.000000 0.000000 1.000000

# Right vertices (x=1)
v 1.000000 1.000000 0.000000
v 1.000000 1.000000 0.500000
v 1.000000 0.500000 0.000000
v 1.000000 0.500000 0.500000
v 1.000000 0.500000 1.000000
v 1.000000 0.000000 0.000000
v 1.000000 0.000000 1.000000

# UV (original)
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

# UV (rotated 90° clockwise)
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vt 0.000000 0.000000

# Normals
vn 0.0000 1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn -1.0000 0.0000 0.0000
vn 1.0000 0.0000 0.0000
vn 0.0000 0.0000 -1.0000
vn 0.0000 0.0000 1.0000

s off
usemtl default

# Bottom (y=0) - rotated UV
f 13/5/2 14/6/2 7/7/2 6/8/2

# Back wall (z=0, full height) - rotated UV
f 6/5/5 1/6/5 8/7/5 13/8/5

# Front lower step (z=1, y=0 to 0.5) - rotated UV
f 14/5/6 12/6/6 5/7/6 7/8/6

# Front upper step (z=0.5, y=0.5 to 1) - rotated UV
f 11/5/6 9/6/6 2/7/6 4/8/6

# Top upper step (y=1, z=0 to 0.5) - rotated UV
f 9/5/1 8/6/1 1/7/1 2/8/1

# Top lower step (y=0.5, z=0.5 to 1) - rotated UV
f 12/5/1 11/6/1 4/7/1 5/8/1

# Left lower (y=0 to 0.5) - rotated UV
f 7/5/3 5/6/3 3/7/3 6/8/3

# Left upper (y=0.5 to 1) - rotated UV
f 4/5/3 2/6/3 1/7/3 3/8/3

# Right lower (y=0 to 0.5) - rotated UV
f 13/5/4 10/6/4 12/7/4 14/8/4

# Right upper (y=0.5 to 1) - rotated UV
f 10/5/4 8/6/4 9/7/4 11/8/4